// Prisma schema for Usuarios Bounded Context
generator usuariosClient {
    provider   = "prisma-client-js"
    outputMode = "outputDir"
    output     = "../../node_modules/@internal/usuarios-client"
    engineType = "client"
}

datasource usuariosDb {
    provider = "postgresql"
}

// ===== ENUMS =====
enum Role {
    USER
    ADMIN
    FINCA
    CLIENTE
}

// ===== USUARIOS MODELS =====
model User {
    id        String  @id @default(cuid())
    email     String  @unique
    username  String  @unique
    password  String
    firstName String
    lastName  String
    isActive  Boolean @default(true)
    role      Role    @default(USER)

    // 2FA
    twoFactorEnabled Boolean @default(false)
    twoFactorSecret  String?

    // Relaciones
    trustedDevices TrustedDevice[]
    /// Usuario de finca (rol FINCA): las fincas para las que carga en el portal.
    fincas         UsuarioFinca[]
    /// Usuario de cliente (rol CLIENTE): los clientes cuyas guías ve en el portal de clientes.
    clientes       UsuarioCliente[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

/// Fincas de un usuario del portal de fincas (como WEB_sisFincas del sistema
/// viejo: un usuario puede cargar para una o varias fincas). `idFinca` apunta a
/// datos_maestros."Finca" (otro schema: FK lógica).
model UsuarioFinca {
    userId    String
    idFinca   Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@id([userId, idFinca])
    @@index([idFinca])
}

/// Clientes de un usuario del portal de clientes (rol CLIENTE). `idCliente` apunta a
/// datos_maestros."Cliente" (el cliente de la marca: ve las guías de sus marcas).
model UsuarioCliente {
    userId    String
    idCliente Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@id([userId, idCliente])
    @@index([idCliente])
}

model TrustedDevice {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Identificación del dispositivo
    fingerprint String // Hash único del dispositivo
    trustToken  String @unique // Token para validar

    // Info legible (para que el usuario vea sus dispositivos)
    deviceName String // "iPhone 13"
    browser    String // "Chrome"
    os         String // "iOS 16"
    deviceType String // "mobile"

    // Seguridad
    lastUsedAt    DateTime @default(now())
    lastIpAddress String?
    expiresAt     DateTime // Expiración del trust (ej: 30 días)

    createdAt DateTime @default(now())

    @@unique([userId, fingerprint])
    @@index([userId])
    @@index([fingerprint])
    @@index([trustToken])
}
