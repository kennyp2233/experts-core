// Prisma schema for EBF Portal sync side-car.
// Vive en prisma/extensions/ porque NO es un bounded context de dominio —
// es metadata de sincronización entre Access (legacy) y EBF (portal externo).
// Ver ACCESS_EBF_SYNC.md del módulo ebf-portal.

generator ebfPortalSyncClient {
  provider   = "prisma-client-js"
  outputMode = "outputDir"
  output     = "../../../node_modules/@internal/ebf-portal-sync-client"
  engineType = "client"
}

datasource ebfPortalSyncDb {
  provider = "postgresql"
}

// ===== SYNC MAPPING (1 fila por coordinación EBF) =====

/// Estado del match de UNA coordinación EBF (= 1 AWB × 1 exportador × 1 producto).
/// El AWB se normaliza sin espacio: "157-46654543" (no "157-4665 4543").
model EbfCoordinacionSync {
  id Int @id @default(autoincrement())

  // === Identidad EBF (id accionable — usado para update/delete) ===
  /// "detalleId" en URLs como /exportador/coordinacion/<id>/update/
  ebfDetalleId      Int     @unique @map("ebf_detalle_id")
  /// "EBF100312224" — alternate key humano (visible en lista despacho)
  ebfHawbCode       String? @unique @map("ebf_hawb_code")
  /// id del lado cliente (si está visible) — ej. 9850
  ebfAwbCustomerId  Int?    @map("ebf_awb_customer_id")

  // === Identificadores cruzados (anclas de match) ===
  /// AWB IATA normalizado sin espacio
  awbNumber       String  @map("awb_number")
  /// DAE/FUE SENAE — "055-2026-40-XXXXXXXX"
  daeNumber       String? @map("dae_number")
  /// "EXPERTS HANDLING CARGO" / "FLORIECOLOGIC" / ...
  exportadorEbf   String  @map("exportador_ebf")
  /// alias EBF agrupado: "KAM", "RDUHA", "BRKAM", "IRIDA LONG"
  consigneeAlias  String? @map("consignee_alias")
  /// "ROSAS", "HORTENSIA", etc.
  productoEbf     String? @map("producto_ebf")
  productoEbfId   Int?    @map("producto_ebf_id")
  fechaVuelo      DateTime? @map("fecha_vuelo")
  /// "KZTSE", "KZALA" — con prefijo país del EBF cliente
  destinoFinal    String? @map("destino_final")

  // === Snapshot de métricas EBF (para detectar cambios al pollear) ===
  ebfFbCoo  Float? @map("ebf_fb_coo")
  ebfHbCoo  Float? @map("ebf_hb_coo")
  ebfQbCoo  Float? @map("ebf_qb_coo")
  ebfEbCoo  Float? @map("ebf_eb_coo")
  ebfBxsCoo Float? @map("ebf_bxs_coo")
  ebfPcsCoo Float? @map("ebf_pcs_coo")
  /// 0 mientras WH no cierre
  ebfBxsWh  Float? @map("ebf_bxs_wh")
  ebfPcsWh  Float? @map("ebf_pcs_wh")

  // === Estado del match ===
  /// AWB_EXACT | DAE_ONLY | COMPOSITE | MANUAL | NONE
  matchStrategy    String  @map("match_strategy")
  matchConfidence  Float   @map("match_confidence")
  /// SYNCED | ONLY_ACCESS | ONLY_EBF | MISMATCH | MANUAL_REVIEW | IGNORED
  status           String
  /// false para AWBs ajenos a EXPERTS (caso FLORIECOLOGIC etc.)
  isOwnedByExperts Boolean @default(false) @map("is_owned_by_experts")
  /// { bxsCoo: { access: 4, ebf: 4.25 }, pesos: { ... } }
  discrepancies    Json?

  // === Auditoría ===
  lastSyncAt    DateTime? @map("last_sync_at")
  /// Cuándo cambió algo en EBF (snapshot vs anterior)
  lastChangedAt DateTime? @map("last_changed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // === Relaciones ===
  accessLinks EbfDetalleAccessLink[]

  @@index([awbNumber])
  @@index([daeNumber])
  @@index([status, exportadorEbf])
  @@index([lastSyncAt])
  @@map("ebf_coordinacion_sync")
}

// ===== N:1 DETAIL LINKS (Access detalle → EBF coordinación) =====

/// Une N filas de PIN_DCoordina (cajas físicas Access) con 1 EbfCoordinacionSync.
/// La asimetría es esperada: 1 EBF coordinación agrupa varios HAWBs físicos Access.
model EbfDetalleAccessLink {
  id        Int                 @id @default(autoincrement())
  ebfSyncId Int                 @map("ebf_sync_id")
  ebfSync   EbfCoordinacionSync @relation(fields: [ebfSyncId], references: [id], onDelete: Cascade)

  // === Acceso (clave compuesta como columnas indexadas, NO FK) ===
  accessBodCodigo Int     @map("access_bod_codigo")
  accessDocTipo   String  @map("access_doc_tipo")
  accessDocNumero Int     @map("access_doc_numero")
  /// null si es link a nivel header
  accessDetNumero Int?    @map("access_det_numero")
  /// PIN_DCoordina.detGuiaHija — el HAWB físico Access
  accessHawb      BigInt? @map("access_hawb")
  /// finca / plantación
  accessPlaCodigo Int?    @map("access_pla_codigo")
  /// producto Access ("CLAVEL", "ROSAS"...)
  accessProCodigo String? @map("access_pro_codigo")
  /// PIN_DCoordina.detFUE — debería coincidir con daeNumber del EBF
  accessFue       String? @map("access_fue")

  /// AWB_EXACT | FUE_EXACT | COMPOSITE | MANUAL
  matchReason String   @map("match_reason")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accessBodCodigo, accessDocTipo, accessDocNumero])
  @@index([accessFue])
  @@index([accessHawb])
  @@index([ebfSyncId])
  @@map("ebf_detalle_access_link")
}

// ===== CATÁLOGO DE MAPEO ENTRE IDS DE LOS DOS SISTEMAS =====

/// Mapping de IDs internos entre Access y EBF para entidades de catálogo
/// (consignees, fincas, aerolíneas, destinos, productos). Resuelve la
/// asimetría N:1 de consignees y otros desalineamientos de naming.
model EbfCatalogMapping {
  id         Int     @id @default(autoincrement())
  /// consignee | shipper | airline | destination | product
  entityType String  @map("entity_type")
  accessId   String? @map("access_id")
  ebfId      String? @map("ebf_id")
  /// para debug humano
  name       String
  confidence Float?  @default(1.0)
  /// true si lo confirmó un humano (no auto-derivado)
  isManual   Boolean @default(false) @map("is_manual")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([entityType, accessId])
  @@unique([entityType, ebfId])
  @@index([entityType])
  @@map("ebf_catalog_mapping")
}

// ===== COORDINACIONES DEL SISTEMA NUEVO FRENTE A EBF (ADR 0004) =====
// No es una copia de EBF: lo que debe haber allá sale siempre de la
// coordinación (schema documentos); aquí queda lo último que se leyó del
// portal, las equivalencias y lo que se envió.

/// Equivalencia entre un registro de datos maestros y el de EBF.
/// FINCA: Finca ↔ exportador · MARCA: Consignatario ↔ marcación · PRODUCTO: Producto ↔ producto.
model EbfEquivalencia {
  id         Int      @id @default(autoincrement())
  /// FINCA | MARCA | PRODUCTO
  tipo       String
  /// id en datos maestros (Finca, Consignatario o Producto)
  idLocal    Int      @map("id_local")
  /// id en EBF (exportador, consignatario_marcacion, producto); null si solo se conoce el nombre
  ebfId      Int?     @map("ebf_id")
  /// como lo muestra EBF en sus listas ("MATIZ ROSES", "KAM", "SPRAY ROSES")
  ebfNombre  String   @map("ebf_nombre")
  /// HISTORIAL (de lo que ya se tipeó en EBF) | RUC (registro de DAEs de EBF) | MANUAL
  origen     String
  /// veces que se vio en el historial
  vecesVista Int      @default(0) @map("veces_vista")
  confirmada Boolean  @default(false)
  confirmadaPor String? @map("confirmada_por")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tipo, idLocal])
  @@index([tipo, ebfNombre])
  @@map("ebf_equivalencia")
}

/// Una coordinación (documentos.DocumentoCoordinacion) frente a EBF.
model EbfCoordinacion {
  id             Int      @id @default(autoincrement())
  /// documentos.DocumentoCoordinacion.id (FK lógica: queda aunque se anule)
  idCoordinacion Int      @unique @map("id_coordinacion")
  /// N° para mostrarla (el propio o el de Access)
  numero         Int?
  numeroGuia     String?  @map("numero_guia")
  fechaVuelo     DateTime @map("fecha_vuelo") @ebfPortalSyncDb.Date
  /// Marca principal (datos maestros); si cambia, el vuelo de EBF es otro
  idConsignatario Int?    @map("id_consignatario")
  /// true: creada en el sistema nuevo (se envía); false: viene de Access (solo se compara)
  enviable       Boolean  @default(false)
  anulada        Boolean  @default(false)
  /// "vuelo" (doc_coordinacion) de EBF: cliente × marcación × fecha × ruta
  ebfVueloId     Int?     @map("ebf_vuelo_id")
  ebfVuelo       String?  @map("ebf_vuelo")
  /// Guía que muestra EBF: la real o la provisional ("EBF-0000 6915")
  ebfGuia        String?  @map("ebf_guia")
  /// IN PROGRESS | DEPARTED | DELIVERED (portal de cliente)
  ebfEstado      String?  @map("ebf_estado")
  ebfFulls       Float?   @map("ebf_fulls")
  ebfCajas       Int?     @map("ebf_cajas")
  ebfFullsBodega Float?   @map("ebf_fulls_bodega")
  ebfCajasBodega Int?     @map("ebf_cajas_bodega")
  ebfPesoBruto   Float?   @map("ebf_peso_bruto")
  ebfPesoCobrable Float?  @map("ebf_peso_cobrable")
  /// Filas del despacho / histórico de EBF de este vuelo en la última lectura
  /// (con esto se recalcula lo pendiente cuando cambia la coordinación, sin volver a leer EBF)
  ebfFilas       Json?    @map("ebf_filas")
  /// Avisos de la lectura (p. ej. "EBF le asignó otra guía")
  avisos         Json?
  leidoEn        DateTime? @map("leido_en")
  errorLectura   String?  @map("error_lectura")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  lineas EbfLinea[]

  @@index([fechaVuelo])
  @@map("ebf_coordinacion")
}

/// Una guía hija (marca × finca × producto × DAE) frente a sus filas en EBF.
/// Lo pendiente es uno solo por línea: se recalcula, no se apila.
model EbfLinea {
  id                Int             @id @default(autoincrement())
  idEbfCoordinacion Int             @map("id_ebf_coordinacion")
  coordinacion      EbfCoordinacion @relation(fields: [idEbfCoordinacion], references: [id], onDelete: Cascade)
  /// "idConsignatario|idFinca|idProducto|dae"
  clave             String
  idFinca           Int             @map("id_finca")
  idProducto        Int?            @map("id_producto")
  idConsignatario   Int             @map("id_consignatario")
  numeroGuiaHija    String?         @map("numero_guia_hija")

  // === Lo que debe haber en EBF (de la coordinación) ===
  dae          String?
  fulls        Float   @default(0)
  cajas        Int     @default(0)
  /// { FB, HB, QB, EB }
  cajasPorTipo Json?   @map("cajas_por_tipo")

  // === Lo último que se vio en EBF ===
  ebfDetalleIds  Int[]     @default([]) @map("ebf_detalle_ids")
  ebfHawb        String?   @map("ebf_hawb")
  ebfExportador  String?   @map("ebf_exportador")
  ebfProducto    String?   @map("ebf_producto")
  ebfDae         String?   @map("ebf_dae")
  ebfFulls       Float?    @map("ebf_fulls")
  ebfCajas       Int?      @map("ebf_cajas")
  ebfFullsBodega Float?    @map("ebf_fulls_bodega")
  ebfCajasBodega Int?      @map("ebf_cajas_bodega")
  /// Fecha de coordinación en EBF de la fila más reciente (solo ese día se edita o borra)
  ebfCreadoEn    DateTime? @map("ebf_creado_en")
  ebfCreadoPor   String?   @map("ebf_creado_por")

  // === Conciliación ===
  /// EN_EBF | POR_ENVIAR | CAMBIO_POR_ENVIAR | PEDIR_A_EBF | FALTA_ENLACE | SOLO_EN_EBF | ERROR | OMITIDA
  estado        String
  /// CREAR | AGREGAR | MODIFICAR | BORRAR | REEMPLAZAR
  accion        String?
  accionDetalle Json?   @map("accion_detalle")
  motivo        String?
  /// Huella de lo deseado cuando alguien dijo "no enviar": vale hasta que la coordinación cambie
  omitidaHuella String?   @map("omitida_huella")
  ultimoError   String?   @map("ultimo_error")
  intentos      Int       @default(0)
  enviadaEn     DateTime? @map("enviada_en")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([idEbfCoordinacion, clave])
  @@index([estado])
  @@map("ebf_linea")
}

/// Lo que se envió a EBF (o se resolvió a mano), para ver quién hizo qué.
model EbfBitacora {
  id             Int      @id @default(autoincrement())
  idCoordinacion Int      @map("id_coordinacion")
  clave          String?
  /// CREAR | AGREGAR | MODIFICAR | BORRAR | OMITIR | HECHO_A_MANO | LEER
  accion         String
  /// OK | YA_ESTABA | ERROR | CANCELADA
  resultado      String
  detalle        Json?
  usuario        String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([idCoordinacion])
  @@index([createdAt])
  @@map("ebf_bitacora")
}
